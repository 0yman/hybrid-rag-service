# Copy to .env and fill in. Every value is optional; the defaults below run
# the whole pipeline offline with no API key.

# Free key: https://aistudio.google.com/apikey  (no credit card required)
GOOGLE_API_KEY=

# Any OpenAI-format endpoint. Leave the base URL blank for OpenAI itself, or
# point it at Groq / Together / OpenRouter / a local Ollama or vLLM - same
# wire format, same adapter.
OPENAI_API_KEY=
RAG_OPENAI_BASE_URL=
RAG_OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Which embedding backend to index with.
#   local  - sentence-transformers, offline, no quota      (default)
#   gemini - hosted gemini-embedding-001, free tier
#   openai - text-embedding-3-small (or any OpenAI-format host)
#   hash   - deterministic stub, used by the test suite
RAG_EMBEDDING_BACKEND=local

# Which model writes the answers.
#   gemini - gemini-3.6-flash on the free tier
#   openai - any OpenAI-format chat-completions endpoint
#   mock   - deterministic extractive stub, no network
RAG_LLM_BACKEND=mock

# Retrieval
RAG_FINAL_TOP_K=5
RAG_DENSE_TOP_K=20
RAG_LEXICAL_TOP_K=20
RAG_RRF_K=60
RAG_DENSE_WEIGHT=1.0
RAG_LEXICAL_WEIGHT=1.0

# Chunking (words, not characters)
RAG_CHUNK_SIZE=220
RAG_CHUNK_OVERLAP=40
