# Copy this file to .env to change how the app answers.
# Everything is optional: with no key at all, answers quote your documents
# directly, and nothing leaves your computer.

# --- Written answers (pick one) ------------------------------------------
# Google Gemini: free key, no credit card - https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Or any OpenAI-format provider. Leave the URL blank for OpenAI itself, or
# point it at Groq / Together / OpenRouter / a local Ollama.
OPENAI_API_KEY=
RAG_OPENAI_BASE_URL=
RAG_OPENAI_CHAT_MODEL=gpt-4o-mini

# auto (default) = Gemini if its key is set, else OpenAI if set, else quote.
# You can force one: gemini | openai | extractive
RAG_LLM_BACKEND=auto

# --- Advanced ------------------------------------------------------------
# Where the search index lives. local = a small model on this machine.
RAG_EMBEDDING_BACKEND=local
RAG_MAX_UPLOAD_MB=25
RAG_FINAL_TOP_K=5
RAG_CHUNK_SIZE=220
RAG_CHUNK_OVERLAP=40
